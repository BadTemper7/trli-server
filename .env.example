# Copy to server/.env. Do not commit real secrets.
NODE_ENV=development
PORT=5000
# Transactions require a MongoDB replica set (including single-node replica set for development).
MONGODB_URI=mongodb://127.0.0.1:27017/trans_roadway?replicaSet=rs0
JWT_SECRET=replace_with_secure_random_32_plus_bytes
ADMIN_JWT_SECRET=replace_with_different_secure_random_32_plus_bytes
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=12h
ADMIN_SESSION_HOURS=12
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
ADMIN_LOGIN_URL=http://localhost:5174/login
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Trans Roadway Logistics <no-reply@example.com>"

# Designated protected bootstrap Super Admin. Set these only to the actual existing
# account when running migrate:protect-super-admin. Do not invent an account.
# The User Management API refuses updates/deletion/status/permission changes to
# the account flagged isSystemProtected, independent of the displayed role name.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_FIRST_NAME=
SUPER_ADMIN_LAST_NAME=
# Only required to seed an initial bootstrap account; use a secret manager.
SUPER_ADMIN_PASSWORD=
