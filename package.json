{
  "name": "trans-roadway-server",
  "version": "1.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "check": "find src scripts -name '*.js' -print0 | xargs -0 -n1 node --check",
    "seed": "node scripts/seed.js",
    "seed:super-admin": "node scripts/createSuperAdmin.js",
    "migrate:bootstrap-super-admin": "node scripts/migrateBootstrapSuperAdmin.js",
    "migrate:rate-names": "node scripts/migrateRateNames.js",
    "migrate:workflow": "node scripts/migrateConsolidatedWorkflow.js",
    "migrate:24h": "node scripts/enable24HourOperations.js",
    "migrate:payment-evidence": "node scripts/migratePaymentEvidenceIndex.js",
    "migrate:protect-super-admin": "node scripts/protectSystemSuperAdmin.js",
    "migrate:billing-fees": "node scripts/migrateBillingFees.js",
    "test": "node --test tests/*.test.js",
    "migrate:forwarding-indexes": "node scripts/setupForwardingIndexes.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {}
}
